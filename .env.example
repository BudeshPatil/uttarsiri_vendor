# Vite exposes only variables prefixed with VITE_ to the client.
# Local dev:      .env.local      -> http://localhost:5004/api
# Staging build:  .env.staging    -> https://dev.uttarsiri.com/api
# Prod build:     .env.production -> https://uttarsiri.com/api
VITE_API_BASE_URL=http://localhost:5004/api
VITE_APP_NAME=Uttar Siri Vendor
VITE_APP_ENV=development
